# ─── Backend ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─── Base de datos ────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalogo_saas

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT (cambiar en producción) ──────────────────────
JWT_SECRET=cambia-esto-min-32-caracteres-produccion-xxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-esto-refresh-min-32-caracteres-xxx
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe (suscripciones del SaaS) ─────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Cloudinary (imágenes de productos y QR) ─────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ─── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
